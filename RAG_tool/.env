
OPENROUTER_API_KEY=put_your_api_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Embeddings
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
EMBEDDING_DIM=1024

# Debug / Profiling
DEBUG_MODE=false
WARN_INFERENCE_THRESHOLD=20
WARN_PROMPT_THRESHOLD=8000

# Optimization
MAX_PROMPT_TOKENS=3000
REMOVE_DUPLICATES=true
FILTER_ASN1=true
FILTER_CHANGE_HISTORY=true

# Retrieval
TOP_K=3
FETCH_MULTIPLIER=2

# Chunking
CHUNK_SIZE=300
CHUNK_OVERLAP=50
